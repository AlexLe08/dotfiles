# Copy to ~/.gitconfig.local (bootstrap.sh does this) and fill in.
# This file is NOT committed: it holds identity and signing.

[user]
  name = Your Name
  # GitHub -> Settings -> Emails -> "Keep my email addresses private" shows this address
  email = 12345678+your-username@users.noreply.github.com
  signingkey = ~/.ssh/id_ed25519.pub

# Uncomment in Phase 5, AFTER the SSH key exists and is added to GitHub as a signing key.
# Enabling this before the key exists makes every commit fail.
# [commit]
#   gpgsign = true
# [tag]
#   gpgSign = true

# Lets `git log --show-signature` verify your own SSH-signed commits locally.
# Create the file once per machine with:
#   echo "$(git config user.email) $(cat ~/.ssh/id_ed25519.pub)" > ~/.ssh/allowed_signers
# [gpg "ssh"]
#   allowedSignersFile = ~/.ssh/allowed_signers

# If signing ever fails or asks for your passphrase (after a restart, for example), 
# run ssh-add --apple-use-keychain ~/.ssh/id_ed25519 to load the key back into the agent.
