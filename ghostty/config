# ~/.config/ghostty/config. Managed in ~/dotfiles/ghostty/config
# Ghostty only allows comments on their OWN line: a trailing "# ..." becomes part of the value.
# Reload: Cmd+Shift+,   Validate: ghostty +validate-config
# All options: ghostty +show-config --default --docs

font-family = JetBrainsMono Nerd Font
font-size = 14

# Left Option acts as Alt for shell shortcuts (Option+. inserts last argument, Option+d deletes word).
# Right Option still types special characters (é, ©, ™).
macos-option-as-alt = left

window-save-state = always

# Browse themes with: ghostty +list-themes
theme = Liquid Carbon Transparent

# When ssh-ing, install Ghostty's terminfo on the remote (needs `tic` there);
# if that fails, fall back to TERM=xterm-256color. Fixes "Error opening terminal: xterm-ghostty".
shell-integration-features = ssh-env,ssh-terminfo
