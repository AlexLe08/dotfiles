# ~/.zprofile (login shells). Managed in ~/dotfiles/zsh/zprofile
# Sets up Homebrew's environment, including $HOMEBREW_PREFIX used by .zshrc.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Claude Code is a Homebrew cask, which doesn't self-update. This lets Claude Code
# run `brew upgrade claude-code` itself when a new stable version ships, so the
# app triggers its own updates through Homebrew (one updater, no drift).
export CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE=1

# Machine-specific login settings (not committed)
[[ -f "$HOME/.zprofile.local" ]] && source "$HOME/.zprofile.local"

# Docker Desktop's CLI (~/.docker/bin) goes FIRST on PATH, so `docker` never depends on
# OrbStack's /usr/local/bin/docker link. Placed after .zprofile.local so it wins over
# anything added there. The two marker comments match Docker Desktop's own wording,
# which should stop it from re-adding its version of this block on every launch.
# The following lines were added by Docker Desktop to add commands to your PATH.
[[ -d "$HOME/.docker/bin" ]] && export PATH="$HOME/.docker/bin:$PATH"
# End of Docker Desktop section.
