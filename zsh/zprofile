# ~/.zprofile (login shells). Managed in ~/dotfiles/zsh/zprofile
# Sets up Homebrew's environment, including $HOMEBREW_PREFIX used by .zshrc.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Machine-specific login settings (not committed)
[[ -f "$HOME/.zprofile.local" ]] && source "$HOME/.zprofile.local"
